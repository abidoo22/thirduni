# DzVendeur - Environment Variables Template
# Copy to .env and provide your deployment-specific credentials.
# NOTE: Variable names only; never commit sensitive values.

# Database (PostgreSQL / Neon.tech)
DATABASE_URL=

# NextAuth.js v5 (Auth.js) Session & Token Security
AUTH_SECRET=
AUTH_URL=

# Cloudinary Media Storage
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend Transactional Email Service
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Scheduled Background Automation
CRON_SECRET=

# Web Push Notifications (VAPID Keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Telegram Integration (Optional Merchant Alerts)
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Application Runtime Environment
NODE_ENV=
